{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane.local/schema/decision-log.v1.schema.json",
  "title": "Membrane decision log payload v1",
  "description": "Payload of an evidence record with kind decision (CONTRACTS section 4). The gateway writes one per tool call. Fields are null when the gateway could not learn them, for example when the request body does not parse. For require_approval, approval_id names the new pending approval and approver is null.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "decision", "reasons", "agent_id", "manifest_sha256", "tier", "delegator", "tool", "irreversible", "resource", "action_sha256", "approval_id", "approver", "policy_sha256", "data_sha256", "latency_ms", "otel"],
  "$defs": {
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hex64_or_null": { "anyOf": [ { "$ref": "#/$defs/hex64" }, { "type": "null" } ] }
  },
  "properties": {
    "decision_id": { "type": "string", "format": "uuid" },
    "decision": { "enum": ["allow", "deny", "require_approval"] },
    "reasons": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "string",
        "description": "Machine reason. Policy reasons from CONTRACTS section 3, plus gateway reasons rate_limited, policy_error, approval_consumed.",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "agent_id": { "type": ["string", "null"], "description": "Agent id claimed by the identity token. It is not verified when reasons has identity_unverified." },
    "manifest_sha256": { "type": ["string", "null"], "description": "Manifest hash claimed by the identity token." },
    "tier": { "type": ["integer", "null"], "minimum": 1, "maximum": 4 },
    "delegator": { "type": ["string", "null"] },
    "tool": { "type": ["string", "null"] },
    "irreversible": { "type": ["boolean", "null"] },
    "resource": { "type": ["string", "null"] },
    "action_sha256": { "$ref": "#/$defs/hex64_or_null" },
    "approval_id": { "anyOf": [ { "type": "string", "format": "uuid" }, { "type": "null" } ] },
    "approver": { "type": ["string", "null"] },
    "policy_sha256": { "$ref": "#/$defs/hex64_or_null" },
    "data_sha256": { "$ref": "#/$defs/hex64_or_null" },
    "latency_ms": { "type": "number", "minimum": 0 },
    "otel": {
      "type": "object",
      "description": "OpenTelemetry GenAI attributes for an execute_tool span. Names verified in docs/runtime-sources.md.",
      "required": ["gen_ai.operation.name", "gen_ai.tool.call.id"],
      "additionalProperties": false,
      "properties": {
        "gen_ai.operation.name": { "const": "execute_tool" },
        "gen_ai.agent.id": { "type": "string" },
        "gen_ai.agent.name": { "type": "string" },
        "gen_ai.tool.name": { "type": "string" },
        "gen_ai.tool.call.id": { "type": "string" }
      }
    }
  }
}
